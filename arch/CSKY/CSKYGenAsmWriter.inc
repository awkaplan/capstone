/// printInstruction - This method is automatically generated by tablegen
/// from the instruction set description.
static void printInstruction(MCInst *MI, uint64_t Address, SStream *O) {
  SStream_concat0(O, "");
  MnemonicBitsInfo MnemonicInfo = getMnemonic(MI, O);

  SStream_concat0(O, MnemonicInfo.first);

  uint64_t Bits = MnemonicInfo.second;
  CS_ASSERT_RET(Bits != 0 && "Cannot print this instruction.");

  // Fragment 0 encoded into 4 bits for 10 unique commands.
  switch ((Bits >> 13) & 15) {
  default: CS_ASSERT_RET(0 && "Invalid command number.");
  case 0:
    // DBG_VALUE, DBG_VALUE_LIST, DBG_INSTR_REF, DBG_PHI, DBG_LABEL, BUNDLE, ...
    return;
    break;
  case 1:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, BGENI, ISEL16, ISEL32, LOAD_PAIR, NE...
    printOperand(MI, 0, O);
    break;
  case 2:
    // CMPLEI16, CMPLEI32, BNEZAD32, BTSTI16, BTSTI32, CMPHS16, CMPHS32, CMPH...
    printOperand(MI, 1, O);
    break;
  case 3:
    // FSELD, FSELS, FABSM, FABS_D, FABS_S, FADDM, FADD_D, FADD_S, FDIV_D, FD...
    printFPR(MI, 0, O);
    break;
  case 4:
    // JBF16, JBF32, JBF_E, JBT16, JBT32, JBT_E, BF16, BF32, BT16, BT32
    printCSKYSymbolOperand(MI, Address, 1, O);
    return;
    break;
  case 5:
    // JBR16, JBR32, JBSR32, PseudoJMPI32, PseudoJSRI32, BR16, BR32, BSR32, B...
    printCSKYSymbolOperand(MI, Address, 0, O);
    return;
    break;
  case 6:
    // LDQ32, STQ32, FLDMM, FLDM_D, FLDM_S, FSTMM, FSTM_D, FSTM_S, LDM32, STM...
    printRegisterSeq(MI, 1, O);
    SStream_concat0(O, ", (");
    printOperand(MI, 0, O);
    SStream_concat1(O, ')');
    return;
    break;
  case 7:
    // FCMPHS_D, FCMPHS_S, FCMPLT_D, FCMPLT_S, FCMPNE_D, FCMPNE_S, FCMPUO_D, ...
    printFPR(MI, 1, O);
    break;
  case 8:
    // JMPI32, JSRI32
    printConstpool(MI, Address, 0, O);
    return;
    break;
  case 9:
    // POP16, POP32, PUSH16, PUSH32
    printRegisterList(MI, 0, O);
    break;
  }


  // Fragment 1 encoded into 3 bits for 6 unique commands.
  switch ((Bits >> 17) & 7) {
  default: CS_ASSERT_RET(0 && "Invalid command number.");
  case 0:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, BGENI, CMPLEI16, CMPLEI32, FSELD, FS...
    SStream_concat0(O, ", ");
    break;
  case 1:
    // BPOPH, BPOPW, BPUSHH, BPUSHW, CLRF32, CLRT32, DCACHE_CISW32, DCACHE_CI...
    return;
    break;
  case 2:
    // CPRCR32, CPRGR32, CPWCR32, CPWGR32
    SStream_concat0(O, ", <");
    printOperand(MI, 1, O);
    SStream_concat0(O, ", ");
    printOperand(MI, 2, O);
    SStream_concat1(O, '>');
    return;
    break;
  case 3:
    // FLDM, FLDRM, FLDR_D, FLDR_S, FLD_D, FLD_S, FSTM, FSTRM, FSTR_D, FSTR_S...
    SStream_concat0(O, ", (");
    break;
  case 4:
    // MFFCR, MTFCR
    SStream_concat0(O, ", fcr");
    return;
    break;
  case 5:
    // POP32, PUSH32
    SStream_concat0(O, "\t");
    printRegisterList(MI, 0, O);
    return;
    break;
  }


  // Fragment 2 encoded into 4 bits for 10 unique commands.
  switch ((Bits >> 20) & 15) {
  default: CS_ASSERT_RET(0 && "Invalid command number.");
  case 0:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, BGENI, LOAD_PAIR, NEG16, NEG32, Pseu...
    printOperand(MI, 1, O);
    break;
  case 1:
    // CMPLEI16, CMPLEI32, ISEL16, ISEL32, ADDC32, ADDI16, ADDU16XZ, AND16, A...
    printOperand(MI, 2, O);
    break;
  case 2:
    // FSELD, FSELS, FCMPHS_D, FCMPHS_S, FCMPLT_D, FCMPLT_S, FCMPNE_D, FCMPNE...
    printFPR(MI, 2, O);
    break;
  case 3:
    // PseudoLRW16, PseudoLRW32, BEZ32, BHSZ32, BHZ32, BLSZ32, BLZ32, BNEZ32,...
    printCSKYSymbolOperand(MI, Address, 1, O);
    return;
    break;
  case 4:
    // ADDC16, DECF32, DECT32, INCF32, INCT32, SUBC16
    printOperand(MI, 3, O);
    break;
  case 5:
    // BNEZAD32
    printCSKYSymbolOperand(MI, Address, 2, O);
    return;
    break;
  case 6:
    // FABSM, FABS_D, FABS_S, FADDM, FADD_D, FADD_S, FDIV_D, FDIV_S, FDTOS, F...
    printFPR(MI, 1, O);
    break;
  case 7:
    // LRS32B, LRS32H, LRS32W, SRS32B, SRS32H, SRS32W
    printDataSymbol(MI, 1, O);
    return;
    break;
  case 8:
    // LRW16, LRW32, f2FLRW_D, f2FLRW_S
    printConstpool(MI, Address, 1, O);
    return;
    break;
  case 9:
    // LRW16_Gen, LRW32_Gen
    printConstpool(MI, Address, 2, O);
    return;
    break;
  }


  // Fragment 3 encoded into 3 bits for 5 unique commands.
  switch ((Bits >> 24) & 7) {
  default: CS_ASSERT_RET(0 && "Invalid command number.");
  case 0:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, BGENI, CMPLEI16, CMPLEI32, NEG16, NE...
    return;
    break;
  case 1:
    // FSELD, FSELS, ISEL16, ISEL32
    SStream_concat0(O, ", src2");
    return;
    break;
  case 2:
    // LOAD_PAIR, PseudoTLSLA32, RESTORE_CARRY, ROTRI32, RSUBI16, RSUBI32, SP...
    SStream_concat0(O, ", ");
    break;
  case 3:
    // CPOP32, CPRC32
    SStream_concat1(O, '>');
    return;
    break;
  case 4:
    // PLDR32, PLDW32
    SStream_concat1(O, ')');
    return;
    break;
  }


  // Fragment 4 encoded into 3 bits for 6 unique commands.
  switch ((Bits >> 27) & 7) {
  default: CS_ASSERT_RET(0 && "Invalid command number.");
  case 0:
    // LOAD_PAIR, RESTORE_CARRY, ROTRI32, RSUBI16, RSUBI32, SPILL_CARRY, STOR...
    printOperand(MI, 2, O);
    break;
  case 1:
    // PseudoTLSLA32
    printConstpool(MI, Address, 2, O);
    SStream_concat0(O, ", ");
    printOperand(MI, 3, O);
    return;
    break;
  case 2:
    // ADDC32, ASRC32, DECGT32, DECLT32, DECNE32, INS32, LSLC32, LSRC32, MULA...
    printOperand(MI, 3, O);
    break;
  case 3:
    // DECF32, DECT32, INCF32, INCT32
    printOperand(MI, 4, O);
    return;
    break;
  case 4:
    // FADDM, FADD_D, FADD_S, FDIV_D, FDIV_S, FMULM, FMUL_D, FMUL_S, FNMULM, ...
    printFPR(MI, 2, O);
    return;
    break;
  case 5:
    // FMACM, FMAC_D, FMAC_S, FMSCM, FMSC_D, FMSC_S, FNMACM, FNMAC_D, FNMAC_S...
    printFPR(MI, 3, O);
    return;
    break;
  }


  // Fragment 5 encoded into 2 bits for 4 unique commands.
  switch ((Bits >> 30) & 3) {
  default: CS_ASSERT_RET(0 && "Invalid command number.");
  case 0:
    // LOAD_PAIR, RESTORE_CARRY, ROTRI32, RSUBI16, RSUBI32, SPILL_CARRY, STOR...
    return;
    break;
  case 1:
    // FLDM, FLD_D, FLD_S, FSTM, FST_D, FST_S, LD16B, LD16H, LD16W, LD16WSP, ...
    SStream_concat1(O, ')');
    return;
    break;
  case 2:
    // FLDRM, FLDR_D, FLDR_S, FSTRM, FSTR_D, FSTR_S, LDR32B, LDR32BS, LDR32H,...
    SStream_concat0(O, " << ");
    printOperand(MI, 3, O);
    SStream_concat1(O, ')');
    return;
    break;
  case 3:
    // INS32, SEXT32, ZEXT32
    SStream_concat0(O, ", ");
    break;
  }


  // Fragment 6 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 32) & 1) {
    // SEXT32, ZEXT32
    printOperand(MI, 3, O);
    return;
  } else {
    // INS32
    printOperand(MI, 4, O);
    return;
  }

}


