static bool printAliasInstr(MCInst *MI, uint64_t Address, SStream *OS) {
#ifndef CAPSTONE_DIET
  static const PatternsForOpcode OpToPatterns[] = {
    {CSKY_JBF16, 0, 1 },
    {CSKY_JBR16, 1, 1 },
    {CSKY_JBSR32, 2, 1 },
    {CSKY_JBT16, 3, 1 },
    {CSKY_PseudoJMPI32, 4, 1 },
    {CSKY_PseudoJSRI32, 5, 1 },
    {CSKY_PseudoLRW16, 6, 1 },
    {CSKY_PseudoLRW32, 7, 1 },
    {CSKY_BSR32, 8, 1 },
    {CSKY_GRS32, 9, 1 },
    {CSKY_JMPI32, 10, 1 },
    {CSKY_JSRI32, 11, 1 },
    {CSKY_LRW16, 12, 1 },
    {CSKY_LRW32, 13, 1 },
    {CSKY_MOV16, 14, 1 },
    {CSKY_MOV32, 15, 1 },
  {0},  };

  static const AliasPattern Patterns[] = {
    // CSKY_JBF16 - 0
    {0, 0, 2, 1 },
    // CSKY_JBR16 - 1
    {9, 1, 1, 0 },
    // CSKY_JBSR32 - 2
    {18, 1, 1, 0 },
    // CSKY_JBT16 - 3
    {28, 1, 2, 1 },
    // CSKY_PseudoJMPI32 - 4
    {37, 2, 1, 0 },
    // CSKY_PseudoJSRI32 - 5
    {47, 2, 1, 0 },
    // CSKY_PseudoLRW16 - 6
    {57, 2, 2, 1 },
    // CSKY_PseudoLRW32 - 7
    {57, 3, 2, 1 },
    // CSKY_BSR32 - 8
    {70, 4, 1, 0 },
    // CSKY_GRS32 - 9
    {79, 4, 2, 1 },
    // CSKY_JMPI32 - 10
    {92, 5, 1, 0 },
    // CSKY_JSRI32 - 11
    {102, 5, 1, 0 },
    // CSKY_LRW16 - 12
    {112, 5, 2, 1 },
    // CSKY_LRW32 - 13
    {112, 6, 2, 1 },
    // CSKY_MOV16 - 14
    {125, 7, 2, 2 },
    // CSKY_MOV32 - 15
    {125, 9, 2, 3 },
  {0},  };

  static const AliasPatternCond Conds[] = {
    // (JBF16 C, br_symbol_16bit:$dst) - 0
    {AliasPatternCond_K_Reg, CSKY_C},
    // (JBR16 br_symbol_16bit:$dst) - 1
    // (JBSR32 call_symbol:$src1) - 1
    // (JBT16 C, br_symbol_16bit:$dst) - 1
    {AliasPatternCond_K_Reg, CSKY_C},
    // (PseudoJMPI32 br_symbol:$dst) - 2
    // (PseudoJSRI32 call_symbol:$dst) - 2
    // (PseudoLRW16 mGPR:$rz, bare_symbol:$src) - 2
    {AliasPatternCond_K_RegClass, CSKY_mGPRRegClassID},
    // (PseudoLRW32 GPR:$rz, bare_symbol:$src) - 3
    {AliasPatternCond_K_RegClass, CSKY_GPRRegClassID},
    // (BSR32 call_symbol:$dst) - 4
    // (GRS32 GPR:$rz, bare_symbol:$offset) - 4
    {AliasPatternCond_K_RegClass, CSKY_GPRRegClassID},
    // (JMPI32 constpool_symbol:$dst) - 5
    // (JSRI32 constpool_symbol:$dst) - 5
    // (LRW16 mGPR:$rz, constpool_symbol_16bit:$src) - 5
    {AliasPatternCond_K_RegClass, CSKY_mGPRRegClassID},
    // (LRW32 GPR:$rz, constpool_symbol:$src) - 6
    {AliasPatternCond_K_RegClass, CSKY_GPRRegClassID},
    // (MOV16 R0, R0) - 7
    {AliasPatternCond_K_Reg, CSKY_R0},
    {AliasPatternCond_K_Reg, CSKY_R0},
    // (MOV32 R0, R0) - 9
    {AliasPatternCond_K_Reg, CSKY_R0},
    {AliasPatternCond_K_Reg, CSKY_R0},
    {AliasPatternCond_K_Feature, CSKY_HasE2},
  {0},  };

  static const char AsmStrings[] =
    /* 0 */ "jbf $\xFF\x02\x01\0"
    /* 9 */ "jbr $\xFF\x01\x01\0"
    /* 18 */ "jbsr	$\xFF\x01\x01\0"
    /* 28 */ "jbt $\xFF\x02\x01\0"
    /* 37 */ "jmpi $\xFF\x01\x01\0"
    /* 47 */ "jsri $\xFF\x01\x01\0"
    /* 57 */ "lrw $\x01, $\xFF\x02\x01\0"
    /* 70 */ "bsr $\xFF\x01\x01\0"
    /* 79 */ "grs	$\x01, $\xFF\x02\x01\0"
    /* 92 */ "jmpi $\xFF\x01\x02\0"
    /* 102 */ "jsri $\xFF\x01\x02\0"
    /* 112 */ "lrw $\x01, $\xFF\x02\x02\0"
    /* 125 */ "nop\0"
  ;

#ifndef NDEBUG
  //static struct SortCheck {
  //  SortCheck(ArrayRef<PatternsForOpcode> OpToPatterns) {
  //    assert(std::is_sorted(
  //               OpToPatterns.begin(), OpToPatterns.end(),
  //               [](const PatternsForOpcode &L, const //PatternsForOpcode &R) {
  //                 return L.Opcode < R.Opcode;
  //               }) &&
  //           "tablegen failed to sort opcode patterns");
  //  }
  //} sortCheckVar(OpToPatterns);
#endif

  AliasMatchingData M = {
    OpToPatterns,
    Patterns,
    Conds,
    AsmStrings,
    CSKYInstPrinterValidateMCOperand,
  };
  const char *AsmString = matchAliasPatterns(MI, &M);
  if (!AsmString) return false;

  unsigned I = 0;
  while (AsmString[I] != ' ' && AsmString[I] != '\t' &&
         AsmString[I] != '$' && AsmString[I] != '\0')
    ++I;
  SStream_concat1(OS, '\t');
  char *substr = cs_mem_malloc(I+1);
  memcpy(substr, AsmString, I);
  substr[I] = '\0';
  SStream_concat0(OS, substr);
  cs_mem_free(substr);
  if (AsmString[I] != '\0') {
    if (AsmString[I] == ' ' || AsmString[I] == '\t') {
      SStream_concat1(OS, '\t');
      ++I;
    }
    do {
      if (AsmString[I] == '$') {
        ++I;
        if (AsmString[I] == (char)0xff) {
          ++I;
          int OpIdx = AsmString[I++] - 1;
          int PrintMethodIdx = AsmString[I++] - 1;
          printCustomAliasOperand(MI, Address, OpIdx, PrintMethodIdx, OS);
        } else
          printOperand(MI, ((unsigned)AsmString[I++]) - 1, OS);
      } else {
        SStream_concat1(OS, AsmString[I++]);
      }
    } while (AsmString[I] != '\0');
  }

  return true;
#else
  return false;
#endif // CAPSTONE_DIET
}

static void printCustomAliasOperand(
         MCInst *MI, uint64_t Address, unsigned OpIdx,
         unsigned PrintMethodIdx,
         SStream *OS) {
#ifndef CAPSTONE_DIET
  switch (PrintMethodIdx) {
  default:
    CS_ASSERT_RET(0 && "Unknown PrintMethod kind");
    break;
  case 0:
    printCSKYSymbolOperand(MI, Address, OpIdx, OS);
    break;
  case 1:
    printConstpool(MI, Address, OpIdx, OS);
    break;
  }
#endif // CAPSTONE_DIET
}

static bool CSKYInstPrinterValidateMCOperand(const MCOperand *MCOp,
                  unsigned PredicateIndex) {
  switch (PredicateIndex) {
  default:
    CS_ASSERT_RET_VAL(0 && "Unknown MCOperandPredicate kind", false);
    return false;
  case 1: {

    int64_t Imm;
    if (MCOperand_isImm(MCOp)) {
      Imm = MCOperand_getImm(MCOp);
      return isShiftedUIntN(5, 0, Imm);
    }
    return MCOperand_isExpr(MCOp);
  
    }
  }
}

